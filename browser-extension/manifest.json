{
  "manifest_version": 3,
  "name": "Clash Compatibility Monitor Browser Companion",
  "description": "Performs opt-in ChatGPT and Gemini conversation checks for Clash Compatibility Monitor.",
  "version": "0.6.2",
  "key": "",
  "permissions": ["nativeMessaging"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["adapter-core.js", "chatgpt-adapter.js", "content-chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["adapter-core.js", "gemini-adapter.js", "content-gemini.js"],
      "run_at": "document_idle"
    }
  ]
}
